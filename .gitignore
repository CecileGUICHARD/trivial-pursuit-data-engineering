# Environnement Python
.venv/
venv/
__pycache__/
*.pyc

# Secrets
.env
.env.*
.streamlit/secrets.toml
*.pem
*.key

# Données locales et livrables publiés
/data/bronze/*
!/data/bronze/.gitkeep
!/data/bronze/questions_raw.csv
!/data/bronze/gemma_p1_choices.parquet
!/data/bronze/gemma_p2_expert.parquet
/data/silver/*
!/data/silver/.gitkeep
!/data/silver/questions_avant_dedoublonnage.parquet
!/data/silver/questions_dedoublonnees.parquet
!/data/silver/questions_normalisees.parquet
!/data/silver/questions_clean.parquet
!/data/silver/diagnostic_anglais_lot2.csv
!/data/silver/classement_diagnostic_anglais_lot2.csv
!/data/silver/rapport_qualite_silver.csv
!/data/silver/gemma_p1_choices.parquet
!/data/silver/gemma_p2_expert.parquet
/data/gold/*
!/data/gold/.gitkeep

# Garder le dossier accessible aux exceptions et ignorer ses fichiers locaux.
!/data/silver/pilot_lot2/
/data/silver/pilot_lot2/*

# Manifeste validé et empreintes nécessaires pour le relire.
!/data/silver/pilot_lot2/pilot_question_ids.parquet
!/data/silver/pilot_lot2/manifest_metadata.json

# Bases de données locales, fichiers temporaires et logs
*.duckdb
*.duckdb.wal
*.db
*.db-wal
*.db-shm
*.db-journal
*.tmp
*.temp
*.log
